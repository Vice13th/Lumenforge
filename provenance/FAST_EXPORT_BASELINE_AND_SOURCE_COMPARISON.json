        "--- older/staged_tile_safe\n",
        "+++ recovered/staged_tile_safe\n",
        "@@ -1,20 +1,12 @@\n",
        " def staged_tile_safe(p):",
        "-    \"\"\"Return True only for operations with a currently verified tile contract.\"\"\"",
        "     if not p:",
        "         return True",
        "     if p.get(\"scene_prep\") or p.get(\"grain\", 0) > .5:",
        "         return False",
        "-    # Vignette currently computes coordinates from the local tile dimensions;",
        "-    # it needs a global-coordinate executor, not merely a halo.",
        "+    if p.get(\"spots\") or abs(p.get(\"distortion\", 0)) > .5:",
        "+        return False",
        "     if abs(p.get(\"vignette\", 0)) > .5:",
        "         return False",
        "-    # Measured halo contracts exist, but export integration is not enabled yet.",
        "-    if tile_halo_requirements(p) > 0:",
        "+    if any(gate(p) for gate, _ in DETAIL_STAGES):",
        "         return False",
        "-    for m in p.get(\"masks\") or []:",
        "-        if not isinstance(m, dict) or not m.get(\"enabled\", True):",
        "-            continue",
        "-        mp = m.get(\"params\") or {}",
        "-        if abs(mp.get(\"clarity\", 0)) > .5:",
        "-            return False",
        "     return True"
      ]
    },
